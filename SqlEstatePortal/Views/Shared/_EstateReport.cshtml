@model SqlEstatePortal.Models.AssessmentRun
@{
    var findings = Model.Findings
        .OrderBy(f => f.Severity == "Critical" ? 0 : f.Severity == "High" ? 1 : f.Severity == "Medium" ? 2 : f.Severity == "Low" ? 3 : 4)
        .ThenBy(f => f.ServerName)
        .ToList();
    var servers = Model.Servers.OrderBy(s => s.ServerName).ToList();
    int CountSev(string sev) => findings.Count(f => string.Equals(f.Severity, sev, StringComparison.OrdinalIgnoreCase));

    // Sysadmins are split by account class so the handful that matter are not
    // buried under the service SIDs setup puts on every instance. See
    // Services/SysadminClassifier.cs for why the built-ins are classified rather
    // than dropped.
    var sysadminsByClass = Model.Sysadmins
        .OrderBy(x => x.ServerName)
        .ThenBy(x => x.Name)
        .GroupBy(SysadminClassifier.Classify)
        .ToDictionary(g => g.Key, g => g.ToList());

    List<AssessmentSysadmin> SysadminsIn(SysadminClassifier.AccountClass c) =>
        sysadminsByClass.TryGetValue(c, out var list) ? list : new List<AssessmentSysadmin>();

    var sysadminTabs = new[]
    {
        (Class: SysadminClassifier.AccountClass.WindowsUser,
         Id: "users",
         Label: "Windows users",
         Blurb: "Named Windows accounts with full control of the instance. An individual person holding sysadmin is the usual audit finding - a group is easier to review and to revoke when someone leaves."),

        (Class: SysadminClassifier.AccountClass.WindowsGroup,
         Id: "groups",
         Label: "Windows groups",
         Blurb: "Windows groups whose members all hold sysadmin. Membership lives in Active Directory, so this lists the grant, not the people it reaches - check the group itself to see who that is."),

        (Class: SysadminClassifier.AccountClass.SqlLogin,
         Id: "sqllogins",
         Label: "SQL logins",
         Blurb: "SQL authentication logins in sysadmin. Anything here other than sa is worth questioning, and sa itself is worth disabling or renaming."),

        (Class: SysadminClassifier.AccountClass.UnknownService,
         Id: "unrecognised",
         Label: "Extension service accounts",
         Blurb: "Service accounts holding sysadmin that SQL Server setup does not create - Azure extensions, backup agents, monitoring tools. Each one is software with full control of the instance, so each should be accounted for."),

        (Class: SysadminClassifier.AccountClass.BuiltInService,
         Id: "builtin",
         Label: "Built-in service accounts",
         Blurb: "Provisioned by SQL Server setup on every instance and listed here for completeness. Their absence matters more than their presence - a missing Agent account will break SQL Agent jobs.")
    };
}
<div class="estate-report">
    <ul class="nav nav-tabs estate-tabs" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-summary" type="button">Summary</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-findings" type="button">Findings</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-status" type="button">Estate status</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-databases" type="button">Databases</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-backups" type="button">Last backups</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-volumes" type="button">Volumes</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-services" type="button">Services</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-waits" type="button">Top waits</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-sysadmins" type="button">Sysadmins</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-jobs" type="button">SQL Agent jobs</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-linkedservers" type="button">Linked servers</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-sqllogins" type="button">SQL logins</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-availabilitygroups" type="button">Availability groups</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-certificates" type="button">Certificates</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-configure" type="button">sp_configure</button></li>
    </ul>

    <div class="tab-content estate-tab-content">
        <div class="tab-pane fade show active" id="tab-summary">
            <div class="stat-grid">
                <div class="stat-card"><div class="label">Servers assessed</div><div class="value">@Model.ServerCount</div></div>
                <div class="stat-card"><div class="label">Reachable</div><div class="value">@Model.ReachableCount</div></div>
                <div class="stat-card"><div class="label">Unreachable</div><div class="value">@Model.UnreachableCount</div></div>
                <div class="stat-card"><div class="label">End of support</div><div class="value">@Model.EndOfSupportCount</div></div>
                <div class="stat-card"><div class="label">Allocated GB</div><div class="value">@Model.AllocatedStorageGb.ToString("N2")</div></div>
                <div class="stat-card"><div class="label">Licensed cores</div><div class="value">@Model.EstimatedLicensedCores</div></div>
                <button type="button" class="stat-card crit sev-jump" data-severity="Critical"><div class="label">Critical</div><div class="value">@Model.CriticalCount</div></button>
                <button type="button" class="stat-card high sev-jump" data-severity="High"><div class="label">High</div><div class="value">@Model.HighCount</div></button>
                <button type="button" class="stat-card med sev-jump" data-severity="Medium"><div class="label">Medium</div><div class="value">@Model.MediumCount</div></button>
                <button type="button" class="stat-card low sev-jump" data-severity="Low"><div class="label">Low</div><div class="value">@Model.LowCount</div></button>
            </div>
            <p class="muted">Choose assessment date and/or server, click <strong>Go</strong>, then open a tab. Click Critical / High / Medium / Low to jump to those findings.</p>
        </div>

        <div class="tab-pane fade" id="tab-findings">
            <div class="severity-tabs" role="tablist">
                <button type="button" class="sev-chip active" data-severity="">All (@findings.Count)</button>
                <button type="button" class="sev-chip sev-critical" data-severity="Critical">Critical (@CountSev("Critical"))</button>
                <button type="button" class="sev-chip sev-high" data-severity="High">High (@CountSev("High"))</button>
                <button type="button" class="sev-chip sev-medium" data-severity="Medium">Medium (@CountSev("Medium"))</button>
                <button type="button" class="sev-chip sev-low" data-severity="Low">Low (@CountSev("Low"))</button>
                <button type="button" class="sev-chip sev-info" data-severity="Info">Info (@CountSev("Info"))</button>
            </div>
            <table class="table table-sm" data-export-name="Findings">
                <thead>
                    @await Html.PartialAsync("_ColumnFilters", new[] { "Severity", "Area", "Server", "Finding", "Recommendation" })
                </thead>
                <tbody>
                @foreach (var f in findings)
                {
                    <tr data-server="@f.ServerName" data-severity="@f.Severity">
                        <td class="sev-@f.Severity.ToLowerInvariant()">
                            @f.Severity
                            @if (FindingSeverityPolicy.WasCapped(f))
                            {
                                @* Show the cap rather than hide it: without this nobody can tell a
                                   genuine Medium from a Critical that was re-ranked, and the rule
                                   becomes impossible to audit or tune. *@
                                <span class="muted d-block sev-capped">from @f.BaseSeverity</span>
                            }
                        </td>
                        <td>@f.Area</td>
                        <td>@f.ServerName</td>
                        <td>@f.Finding</td>
                        <td>@f.Recommendation</td>
                    </tr>
                }
                </tbody>
            </table>
            <p class="muted empty-hint" hidden>No matching rows.</p>
        </div>

        <div class="tab-pane fade" id="tab-status">
            <table class="table table-sm" data-export-name="Estate status">
                <thead>
                    @await Html.PartialAsync("_ColumnFilters", new[] { "Server", "Reachable", "Product", "Support", "Edition", "Version", "CPU", "Memory MB", "Started" })
                </thead>
                <tbody>
                @foreach (var s in servers)
                {
                    <tr data-server="@s.ServerName">
                        <td>@s.ServerName</td>
                        <td>@(s.Reachable ? "Yes" : "No")</td>
                        <td>@s.Product</td>
                        <td>@s.SupportStatus</td>
                        <td>@s.Edition</td>
                        <td>@s.Version</td>
                        <td>@s.CpuCount</td>
                        <td>@s.MemoryMb?.ToString("N2")</td>
                        <td>@s.StartedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="tab-pane fade" id="tab-databases">
            <table class="table table-sm" data-export-name="Databases">
                <thead>
                    @await Html.PartialAsync("_ColumnFilters", new[] { "Server", "Name", "State", "Recovery", "Compat", "Page verify", "Encrypted", "Data MB", "Log MB", "Owner" })
                </thead>
                <tbody>
                @foreach (var d in Model.Databases.OrderBy(x => x.ServerName).ThenBy(x => x.Name))
                {
                    <tr data-server="@d.ServerName">
                        <td>@d.ServerName</td>
                        <td>@d.Name</td>
                        <td>@d.State</td>
                        <td>@d.RecoveryModel</td>
                        <td>@d.CompatibilityLevel</td>
                        <td>@d.PageVerify</td>
                        <td>@(d.IsEncrypted ? "Yes" : "No")</td>
                        <td>@d.DataMb?.ToString("N2")</td>
                        <td>@d.LogMb?.ToString("N2")</td>
                        <td>@d.OwnerName</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="tab-pane fade" id="tab-backups">
            <p class="muted">Last full / differential / log backup times from <code>msdb.dbo.backupset</code> for each database.</p>
            <table class="table table-sm" data-export-name="Last backups">
                <thead>
                    @await Html.PartialAsync("_ColumnFilters", new[]
                    {
                        "Server", "Database", "Last full backup", "Last differential backup", "Last log backup"
                    })
                </thead>
                <tbody>
                @foreach (var b in Model.Backups.OrderBy(x => x.ServerName).ThenBy(x => x.DatabaseName))
                {
                    <tr data-server="@b.ServerName">
                        <td>@b.ServerName</td>
                        <td>@b.DatabaseName</td>
                        <td>@(b.LastFullBackup?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td>@(b.LastDifferentialBackup?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td>@(b.LastLogBackup?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="tab-pane fade" id="tab-volumes">
            <table class="table table-sm" data-export-name="Volumes">
                <thead>
                    @await Html.PartialAsync("_ColumnFilters", new[] { "Server", "Mount", "Name", "Total GB", "Free GB", "Free %" })
                </thead>
                <tbody>
                @foreach (var v in Model.Volumes.OrderBy(x => x.ServerName))
                {
                    <tr data-server="@v.ServerName">
                        <td>@v.ServerName</td>
                        <td>@v.MountPoint</td>
                        <td>@v.LogicalName</td>
                        <td>@v.TotalGb?.ToString("N2")</td>
                        <td>@v.FreeGb?.ToString("N2")</td>
                        <td>@v.FreePct?.ToString("N2")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="tab-pane fade" id="tab-services">
            <table class="table table-sm" data-export-name="Services">
                <thead>
                    @await Html.PartialAsync("_ColumnFilters", new[] { "Server", "Service", "Startup", "Status", "Account", "IFI" })
                </thead>
                <tbody>
                @foreach (var svc in Model.Services.OrderBy(x => x.ServerName))
                {
                    <tr data-server="@svc.ServerName">
                        <td>@svc.ServerName</td>
                        <td>@svc.ServiceName</td>
                        <td>@svc.StartupType</td>
                        <td>@svc.Status</td>
                        <td>@svc.ServiceAccount</td>
                        <td>@svc.InstantFileInitialization</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="tab-pane fade" id="tab-waits">
            <table class="table table-sm" data-export-name="Top waits">
                <thead>
                    @await Html.PartialAsync("_ColumnFilters", new[] { "Server", "Wait type", "Tasks", "Wait ms", "Signal ms", "%" })
                </thead>
                <tbody>
                @foreach (var w in Model.Waits.OrderBy(x => x.ServerName).ThenByDescending(x => x.WaitTimeMs))
                {
                    <tr data-server="@w.ServerName">
                        <td>@w.ServerName</td>
                        <td>@w.WaitType</td>
                        <td>@w.WaitingTasks</td>
                        <td>@w.WaitTimeMs</td>
                        <td>@w.SignalWaitTimeMs</td>
                        <td>@w.WaitPct?.ToString("N2")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="tab-pane fade" id="tab-sysadmins">
            <ul class="nav nav-pills estate-subtabs" role="tablist">
                @for (var i = 0; i < sysadminTabs.Length; i++)
                {
                    var t = sysadminTabs[i];
                    <li class="nav-item">
                        <button class="nav-link @(i == 0 ? "active" : null)" data-bs-toggle="tab"
                                data-bs-target="#tab-sysadmins-@t.Id" type="button" role="tab">
                            @t.Label (@SysadminsIn(t.Class).Count)
                        </button>
                    </li>
                }
            </ul>

            <div class="tab-content estate-subtab-content">
                @for (var i = 0; i < sysadminTabs.Length; i++)
                {
                    var t = sysadminTabs[i];
                    var rows = SysadminsIn(t.Class);
                    <div class="tab-pane fade @(i == 0 ? "show active" : null)" id="tab-sysadmins-@t.Id" role="tabpanel">
                        <p class="muted">@t.Blurb</p>
                        @if (rows.Count == 0)
                        {
                            <p class="muted">None on the assessed instances.</p>
                        }
                        else
                        {
                            <table class="table table-sm" data-export-name="Sysadmins - @t.Label">
                                <thead>
                                    @await Html.PartialAsync("_ColumnFilters", new[] { "Server", "Name", "Type", "Disabled", "Created" })
                                </thead>
                                <tbody>
                                @foreach (var a in rows)
                                {
                                    <tr data-server="@a.ServerName">
                                        <td>@a.ServerName</td>
                                        <td>@a.Name</td>
                                        <td>@a.TypeDesc</td>
                                        <td>@(a.IsDisabled ? "Yes" : "No")</td>
                                        <td>@a.CreateDate?.ToString("yyyy-MM-dd HH:mm")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="tab-pane fade" id="tab-jobs">
            <table class="table table-sm" data-export-name="SQL Agent jobs">
                <thead>
                    @await Html.PartialAsync("_ColumnFilters", new[] { "Server", "Job", "Enabled", "Last status", "Last run", "Message" })
                </thead>
                <tbody>
                @foreach (var j in Model.Jobs.OrderBy(x => x.ServerName))
                {
                    <tr data-server="@j.ServerName">
                        <td>@j.ServerName</td>
                        <td>@j.JobName</td>
                        <td>@(j.Enabled ? "Yes" : "No")</td>
                        <td>@j.LastRunStatus</td>
                        <td>@j.LastRun?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@j.Message</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="tab-pane fade" id="tab-linkedservers">
            <p class="muted">Linked server definitions from <code>sys.servers</code> (<code>is_linked = 1</code>) on each assessed instance. RPC out and remote login widen the blast radius of a compromised instance &mdash; review any that are enabled.</p>
            @if (!Model.LinkedServers.Any())
            {
                <p class="muted">No linked servers found on the assessed instances.</p>
            }
            else
            {
                <table class="table table-sm" data-export-name="Linked servers">
                    <thead>
                        @await Html.PartialAsync("_ColumnFilters", new[]
                        {
                            "Server", "Linked server", "Data source", "Provider", "Remote login", "RPC out"
                        })
                    </thead>
                    <tbody>
                    @foreach (var ls in Model.LinkedServers.OrderBy(x => x.ServerName).ThenBy(x => x.LinkedServerName))
                    {
                        <tr data-server="@ls.ServerName">
                            <td>@ls.ServerName</td>
                            <td>@ls.LinkedServerName</td>
                            <td>@ls.DataSource</td>
                            <td>@ls.Provider</td>
                            <td>@(ls.IsRemoteLoginEnabled ? "Yes" : "No")</td>
                            <td>@(ls.IsRpcOutEnabled ? "Yes" : "No")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>

        <div class="tab-pane fade" id="tab-sqllogins">
            <p class="muted">SQL Server authentication logins from <code>sys.sql_logins</code>. Logins without password policy or expiration enforcement, and any sysadmin, are worth reviewing.</p>
            @if (!Model.SqlLogins.Any())
            {
                <p class="muted">No SQL logins were collected for the assessed instances.</p>
            }
            else
            {
                <table class="table table-sm" data-export-name="SQL logins">
                    <thead>
                        @await Html.PartialAsync("_ColumnFilters", new[]
                        {
                            "Server", "Login", "Disabled", "Sysadmin", "Policy checked", "Expiration checked", "Created", "Modified"
                        })
                    </thead>
                    <tbody>
                    @foreach (var lg in Model.SqlLogins.OrderBy(x => x.ServerName).ThenBy(x => x.LoginName))
                    {
                        <tr data-server="@lg.ServerName">
                            <td>@lg.ServerName</td>
                            <td>@lg.LoginName</td>
                            <td>@(lg.IsDisabled ? "Yes" : "No")</td>
                            <td>@(lg.IsSysadmin ? "Yes" : "No")</td>
                            <td>@(lg.IsPolicyChecked ? "Yes" : "No")</td>
                            <td>@(lg.IsExpirationChecked ? "Yes" : "No")</td>
                            <td>@(lg.CreateDate?.ToString("yyyy-MM-dd") ?? "")</td>
                            <td>@(lg.ModifyDate?.ToString("yyyy-MM-dd") ?? "")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>

        <div class="tab-pane fade" id="tab-availabilitygroups">
            <p class="muted">Always On availability groups and their replicas, from <code>sys.availability_groups</code> joined to <code>sys.dm_hadr_availability_replica_states</code>.</p>
            @if (!Model.AvailabilityGroups.Any())
            {
                <p class="muted">No availability groups found on the assessed instances.</p>
            }
            else
            {
                <table class="table table-sm" data-export-name="Availability groups">
                    <thead>
                        @await Html.PartialAsync("_ColumnFilters", new[]
                        {
                            "Server", "Availability group", "Replica", "Role", "Operational state", "Connected state", "Synchronisation health"
                        })
                    </thead>
                    <tbody>
                    @foreach (var ag in Model.AvailabilityGroups.OrderBy(x => x.ServerName).ThenBy(x => x.AgName).ThenBy(x => x.ReplicaServerName))
                    {
                        <tr data-server="@ag.ServerName">
                            <td>@ag.ServerName</td>
                            <td>@ag.AgName</td>
                            <td>@ag.ReplicaServerName</td>
                            <td>@ag.RoleDesc</td>
                            <td>@ag.OperationalStateDesc</td>
                            <td>@ag.ConnectedStateDesc</td>
                            <td>@ag.SynchronizationHealthDesc</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>

        <div class="tab-pane fade" id="tab-certificates">
            <ul class="nav nav-pills estate-subtabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-certs-database" type="button" role="tab">
                        Database certificates (@Model.Certificates.Count())
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-certs-tls" type="button" role="tab">
                        TLS / connection certificates (@Model.TlsCertificates.Count())
                    </button>
                </li>
            </ul>

            <div class="tab-content estate-subtab-content">
            <div class="tab-pane fade show active" id="tab-certs-database" role="tabpanel">
            <p class="muted">Certificates from <code>sys.certificates</code>, matched to the databases whose encryption key they protect. Expiry is measured as at the time of the run.</p>
            @if (!Model.Certificates.Any())
            {
                <p class="muted">No certificates found on the assessed instances.</p>
            }
            else
            {
                <table class="table table-sm" data-export-name="Database certificates">
                    <thead>
                        @await Html.PartialAsync("_ColumnFilters", new[]
                        {
                            "Server", "Starts", "Expires", "Days to expiry", "Certificate", "Subject", "Issuer", "Protects", "Private key", "Thumbprint"
                        })
                    </thead>
                    <tbody>
                    @foreach (var c in Model.Certificates.OrderBy(x => x.DaysToExpiry ?? int.MaxValue).ThenBy(x => x.ServerName))
                    {
                        <tr data-server="@c.ServerName">
                            <td>@c.ServerName</td>
                            <td class="text-nowrap">@(c.StartDate?.ToString("yyyy-MM-dd") ?? "")</td>
                            <td class="text-nowrap">@(c.ExpiryDate?.ToString("yyyy-MM-dd") ?? "")</td>
                            <td class="text-nowrap">
                                @if (c.DaysToExpiry is int d)
                                {
                                    if (d < 0)
                                    {
                                        <span class="server-status-text server-status-offline">Expired @(Math.Abs(d)) d ago</span>
                                    }
                                    else if (d <= 30)
                                    {
                                        <span class="server-status-text server-status-offline">@d</span>
                                    }
                                    else
                                    {
                                        <span>@d</span>
                                    }
                                }
                            </td>
                            <td>@c.CertificateName</td>
                            <td>@c.Subject</td>
                            <td>@c.IssuerName</td>
                            <td>@c.ProtectedDatabases</td>
                            <td>@c.PrivateKeyEncryption</td>
                            <td><code>@c.Thumbprint</code></td>
                        </tr>
                    }
                    </tbody>
                </table>
            }

            </div>

            <div class="tab-pane fade" id="tab-certs-tls" role="tabpanel">
            <p class="muted">The certificate each instance presents for encrypted client connections, read from <code>SuperSocketNetLib</code>. A blank thumbprint means SQL Server is self-signing.</p>
            @if (!Model.TlsCertificates.Any())
            {
                <p class="muted">No TLS certificate information was collected. The collector account may not have rights to read the instance registry keys.</p>
            }
            else
            {
                <table class="table table-sm" data-export-name="TLS certificates">
                    <thead>
                        @await Html.PartialAsync("_ColumnFilters", new[]
                        {
                            "Server", "Instance", "Source", "Force encryption", "Thumbprint"
                        })
                    </thead>
                    <tbody>
                    @foreach (var t in Model.TlsCertificates.OrderBy(x => x.ServerName))
                    {
                        <tr data-server="@t.ServerName">
                            <td>@t.ServerName</td>
                            <td>@t.InstanceName</td>
                            <td>@t.CertificateSource</td>
                            <td>@(t.ForceEncryption ? "Yes" : "No")</td>
                            <td><code>@(string.IsNullOrWhiteSpace(t.Thumbprint) ? "—" : t.Thumbprint)</code></td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            </div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-configure">
            <p class="muted">Full <code>sp_configure</code> catalogue from <code>sys.configurations</code> (includes advanced options).</p>
            <table class="table table-sm" data-export-name="sp_configure">
                <thead>
                    @await Html.PartialAsync("_ColumnFilters", new[]
                    {
                        "Server", "Name", "Minimum", "Maximum", "Config value", "Run value",
                        "Dynamic", "Advanced", "Description"
                    })
                </thead>
                <tbody>
                @foreach (var c in Model.Configurations.OrderBy(x => x.ServerName).ThenBy(x => x.Name))
                {
                    <tr data-server="@c.ServerName">
                        <td>@c.ServerName</td>
                        <td>@c.Name</td>
                        <td>@c.Minimum</td>
                        <td>@c.Maximum</td>
                        <td>@c.ConfigValue</td>
                        <td>@c.RunValue</td>
                        <td>@(c.IsDynamic ? "Yes" : "No")</td>
                        <td>@(c.IsAdvanced ? "Yes" : "No")</td>
                        <td>@c.Description</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
